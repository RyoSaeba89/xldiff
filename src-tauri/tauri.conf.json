{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XLDiff",
  "version": "2.0.0",
  "identifier": "fr.strasbourg.eurometropole.xldiff",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XLDiff — Comparateur de fichiers Excel",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
